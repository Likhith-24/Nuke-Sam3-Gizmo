 # ═══════════════════════════════════════════════════════════
 # POSITIVE BOUNDING BOX (CornerPin2D)
 # Drag corners to define the include region
 # ═══════════════════════════════════════════════════════════
 
 CornerPin2D {
  inputs 0
  to1 {480 270}
  to2 {1440 270}
  to3 {1440 810}
  to4 {480 810}
  invert false
  from1 {480 270}
  from2 {1440 270}
  from3 {1440 810}
  from4 {480 810}
  name POS_BBOX
  label "Positive Bbox\n(Include Region)"
  xpos 200
  ypos -400
  disable {{!parent.bbox_enabled}}
 }
 
 # ═══════════════════════════════════════════════════════════
 # NEGATIVE BOUNDING BOX (CornerPin2D, SAM3 only)
 # Drag corners to define the exclude region
 # ═══════════════════════════════════════════════════════════
 
 CornerPin2D {
  inputs 0
  to1 {100 100}
  to2 {200 100}
  to3 {200 200}
  to4 {100 200}
  invert false
  from1 {100 100}
  from2 {200 100}
  from3 {200 200}
  from4 {100 200}
  name NEG_BBOX
  label "Negative Bbox\n(Exclude Region - SAM3)"
  xpos 350
  ypos -400
  disable {{!parent.neg_bbox_enabled}}
 }
 
 # ═══════════════════════════════════════════════════════════
 # Mask placeholder (updated by inference)
 # ═══════════════════════════════════════════════════════════
 
 Constant {
  inputs 0
  channels rgba
  color {0 0 0 0}
  format "1920 1080 0 0 1920 1080 1 HD_1080"
  name MaskSource
  xpos 200
  ypos -200
 }
 
 # ═══════════════════════════════════════════════════════════
 # Merge mask onto input
 # ═══════════════════════════════════════════════════════════
 
 push 0
 Copy {
  inputs 2
  from0 rgba.red
  to0 rgba.alpha
  name CopyAlpha
  xpos 0
  ypos -200
  disable true
 }
 
 Output {
  name Output1
  xpos 0
  ypos 0
 }

end_group
